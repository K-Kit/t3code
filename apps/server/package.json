    "docx": "^9.7.1",
    "effect": "catalog:",
    "mammoth": "^1.12.2",
    "marked": "^18.0.11",
    "msgpackr-extract": "3.0.4",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "smol-toml": "^1.8.0",
    "stream-chain": "^4.2.5",
    "stream-json": "3.6.0",
